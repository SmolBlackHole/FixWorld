<Project>
    <Import Project="$(MSBuildThisFileDirectory)Local.Build.props"
        Condition="Exists('$(MSBuildThisFileDirectory)Local.Build.props')" />

    <PropertyGroup>
        <RimWorldRoot Condition="'$(RimWorldRoot)' == ''">$(RIMWORLD_ROOT)</RimWorldRoot>
        <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == '' and '$(RimWorldRoot)' != ''">$(RimWorldRoot)\RimWorldWin64_Data\Managed</RimWorldManagedDir>
        <HarmonyAssemblyPath Condition="'$(HarmonyAssemblyPath)' == ''">$(RIMWORLD_HARMONY_ASSEMBLY)</HarmonyAssemblyPath>
        <FixWorldRimWorldReferenceVersion>1.6.4871</FixWorldRimWorldReferenceVersion>
        <FixWorldHarmonyReferenceVersion>2.4.1</FixWorldHarmonyReferenceVersion>
        <FixWorldUseLocalGameReferences Condition="'$(FixWorldUseLocalGameReferences)' == '' and Exists('$(RimWorldManagedDir)\Assembly-CSharp.dll')">true</FixWorldUseLocalGameReferences>
        <FixWorldUseLocalGameReferences Condition="'$(FixWorldUseLocalGameReferences)' == ''">false</FixWorldUseLocalGameReferences>
        <FixWorldUseLocalHarmonyReference Condition="'$(FixWorldUseLocalHarmonyReference)' == '' and Exists('$(HarmonyAssemblyPath)')">true</FixWorldUseLocalHarmonyReference>
        <FixWorldUseLocalHarmonyReference Condition="'$(FixWorldUseLocalHarmonyReference)' == ''">false</FixWorldUseLocalHarmonyReference>
    </PropertyGroup>
</Project>
