<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>FixWorld</AssemblyName>
    <RootNamespace>FixWorld</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>true</Optimize>
    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472"
      Version="1.0.3"
      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\preloader\Shared\DdsCacheContract.cs"
      Link="Textures\DdsCacheContract.cs" />
    <Compile Include="..\..\..\preloader\Shared\PreloaderInstallation.cs"
      Link="Preloader\PreloaderInstallation.cs" />
    <Compile Include="..\..\..\preloader\Shared\PreloaderTimeline.cs"
      Link="Preloader\PreloaderTimeline.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateLocalRimWorldReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RimWorldManagedDir)\Assembly-CSharp.dll')"
      Text="Assembly-CSharp.dll is missing. Set RimWorldRoot in mod/Local.Build.props or RIMWORLD_ROOT." />
    <Error Condition="!Exists('$(RimWorldManagedDir)\UnityEngine.CoreModule.dll')"
      Text="UnityEngine.CoreModule.dll is missing. Set RimWorldRoot in mod/Local.Build.props or RIMWORLD_ROOT." />
    <Error Condition="!Exists('$(RimWorldManagedDir)\UnityEngine.AudioModule.dll')"
      Text="UnityEngine.AudioModule.dll is missing. Set RimWorldRoot in mod/Local.Build.props or RIMWORLD_ROOT." />
    <Error Condition="!Exists('$(RimWorldManagedDir)\UnityEngine.ImageConversionModule.dll')"
      Text="UnityEngine.ImageConversionModule.dll is missing. Set RimWorldRoot in mod/Local.Build.props or RIMWORLD_ROOT." />
    <Error Condition="!Exists('$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll')"
      Text="UnityEngine.IMGUIModule.dll is missing. Set RimWorldRoot in mod/Local.Build.props or RIMWORLD_ROOT." />
    <Error Condition="!Exists('$(RimWorldManagedDir)\UnityEngine.TextRenderingModule.dll')"
      Text="UnityEngine.TextRenderingModule.dll is missing. Set RimWorldRoot in mod/Local.Build.props or RIMWORLD_ROOT." />
    <Error Condition="!Exists('$(HarmonyAssemblyPath)')"
      Text="0Harmony.dll is missing. Set HarmonyAssemblyPath in mod/Local.Build.props or RIMWORLD_HARMONY_ASSEMBLY." />
  </Target>

  <Target Name="Package" DependsOnTargets="Build">
    <PropertyGroup>
      <FixWorldDistDir>$(MSBuildProjectDirectory)\..\..\..\dist</FixWorldDistDir>
      <FixWorldPackageStage>$(FixWorldDistDir)\.package</FixWorldPackageStage>
      <FixWorldPackageZip>$(FixWorldDistDir)\FixWorld-pilot-win-x64.zip</FixWorldPackageZip>
    </PropertyGroup>
    <ItemGroup>
      <FixWorldPackageFile Include="$(MSBuildProjectDirectory)\..\About\About.xml">
        <PackagePath>About\About.xml</PackagePath>
      </FixWorldPackageFile>
      <FixWorldPackageFile Include="$(MSBuildProjectDirectory)\..\Assemblies\FixWorld.dll">
        <PackagePath>Assemblies\FixWorld.dll</PackagePath>
      </FixWorldPackageFile>
      <FixWorldPackageFile Include="$(MSBuildProjectDirectory)\..\Tools\DirectXTex-LICENSE.txt">
        <PackagePath>Tools\DirectXTex-LICENSE.txt</PackagePath>
      </FixWorldPackageFile>
      <FixWorldPackageFile Include="$(MSBuildProjectDirectory)\..\Tools\Cleanup-DdsCache.ps1">
        <PackagePath>Tools\Cleanup-DdsCache.ps1</PackagePath>
      </FixWorldPackageFile>
      <FixWorldPackageFile Include="$(MSBuildProjectDirectory)\..\Tools\Windows-x64\texconv.exe">
        <PackagePath>Tools\Windows-x64\texconv.exe</PackagePath>
      </FixWorldPackageFile>
      <FixWorldPackageFile
        Include="$(MSBuildProjectDirectory)\..\Tools\Windows-x64\FixWorld.Preloader.dll">
        <PackagePath>Tools\Windows-x64\FixWorld.Preloader.dll</PackagePath>
      </FixWorldPackageFile>
      <FixWorldPackageFile
        Include="$(MSBuildProjectDirectory)\..\Tools\Windows-x64\FixWorld.Loader.dll">
        <PackagePath>Tools\Windows-x64\FixWorld.Loader.dll</PackagePath>
      </FixWorldPackageFile>
      <FixWorldPackageFile
        Include="$(MSBuildProjectDirectory)\..\Tools\Windows-x64\FixWorld.Preloader.Tool.exe">
        <PackagePath>Tools\Windows-x64\FixWorld.Preloader.Tool.exe</PackagePath>
      </FixWorldPackageFile>
      <FixWorldPackageFile
        Include="$(MSBuildProjectDirectory)\..\Tools\Windows-x64\FixWorld.Preloader.Tool.exe.config">
        <PackagePath>Tools\Windows-x64\FixWorld.Preloader.Tool.exe.config</PackagePath>
      </FixWorldPackageFile>
      <FixWorldPackageFile
        Include="$(MSBuildProjectDirectory)\..\Tools\Windows-x64\Doorstop-4.4.0\.doorstop_version">
        <PackagePath>Tools\Windows-x64\Doorstop-4.4.0\.doorstop_version</PackagePath>
      </FixWorldPackageFile>
      <FixWorldPackageFile
        Include="$(MSBuildProjectDirectory)\..\Tools\Windows-x64\Doorstop-4.4.0\manifest.json">
        <PackagePath>Tools\Windows-x64\Doorstop-4.4.0\manifest.json</PackagePath>
      </FixWorldPackageFile>
      <FixWorldPackageFile
        Include="$(MSBuildProjectDirectory)\..\Tools\Windows-x64\Doorstop-4.4.0\UnityDoorstop-LICENSE.txt">
        <PackagePath>Tools\Windows-x64\Doorstop-4.4.0\UnityDoorstop-LICENSE.txt</PackagePath>
      </FixWorldPackageFile>
      <FixWorldPackageFile
        Include="$(MSBuildProjectDirectory)\..\Tools\Windows-x64\Doorstop-4.4.0\winhttp.dll">
        <PackagePath>Tools\Windows-x64\Doorstop-4.4.0\winhttp.dll</PackagePath>
      </FixWorldPackageFile>
    </ItemGroup>
    <RemoveDir Directories="$(FixWorldPackageStage)" />
    <MakeDir Directories="$(FixWorldPackageStage)\FixWorld" />
    <Copy
      SourceFiles="@(FixWorldPackageFile)"
      DestinationFiles="@(FixWorldPackageFile->'$(FixWorldPackageStage)\FixWorld\%(PackagePath)')" />
    <Delete Files="$(FixWorldPackageZip)" />
    <ZipDirectory
      SourceDirectory="$(FixWorldPackageStage)"
      DestinationFile="$(FixWorldPackageZip)"
      Overwrite="true" />
    <RemoveDir Directories="$(FixWorldPackageStage)" />
    <Message Importance="high" Text="FixWorld package: $(FixWorldPackageZip)" />
  </Target>
</Project>