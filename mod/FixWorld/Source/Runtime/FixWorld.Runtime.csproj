<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>latest</LangVersion>
        <PlatformTarget>x64</PlatformTarget>
        <AssemblyName>FixWorld.Runtime</AssemblyName>
        <RootNamespace>FixWorld.Runtime</RootNamespace>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <Deterministic>true</Deterministic>
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <Optimize>true</Optimize>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <OutputPath>..\..\Tools\Windows-x64\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472"
            Version="1.0.3"
            PrivateAssets="all" />
        <PackageReference Include="Krafs.Rimworld.Ref"
            Version="$(FixWorldRimWorldReferenceVersion)"
            ExcludeAssets="runtime"
            PrivateAssets="all"
            Condition="'$(FixWorldUseLocalGameReferences)' != 'true'" />
        <PackageReference Include="Lib.Harmony"
            Version="$(FixWorldHarmonyReferenceVersion)"
            ExcludeAssets="runtime"
            PrivateAssets="all"
            Condition="'$(FixWorldUseLocalHarmonyReference)' != 'true'" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shared\FixWorld.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Tool\TexconvProcess.cs"
            Link="Source\ExternalTools\TexconvProcess.cs" />
    </ItemGroup>

    <ItemGroup Condition="'$(FixWorldUseLocalGameReferences)' == 'true'">
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.AudioModule">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.AudioModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.AssetBundleModule">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.ImageConversionModule">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(RimWorldManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="System.Runtime.Serialization" />
    </ItemGroup>

    <ItemGroup Condition="'$(FixWorldUseLocalHarmonyReference)' == 'true'">
        <Reference Include="0Harmony">
            <HintPath>$(HarmonyAssemblyPath)</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <Target Name="ValidateLocalGameReferences"
        BeforeTargets="ResolveReferences"
        Condition="'$(FixWorldUseLocalGameReferences)' == 'true'">
        <Error Condition="!Exists('$(RimWorldManagedDir)\Assembly-CSharp.dll')"
            Text="Assembly-CSharp.dll is missing. Set RimWorldRoot in mod/FixWorld/Local.Build.props or RIMWORLD_ROOT." />
        <Error Condition="!Exists('$(RimWorldManagedDir)\UnityEngine.CoreModule.dll')"
            Text="UnityEngine.CoreModule.dll is missing. Set RimWorldRoot in mod/FixWorld/Local.Build.props or RIMWORLD_ROOT." />
        <Error Condition="!Exists('$(RimWorldManagedDir)\UnityEngine.AudioModule.dll')"
            Text="UnityEngine.AudioModule.dll is missing. Set RimWorldRoot in mod/FixWorld/Local.Build.props or RIMWORLD_ROOT." />
        <Error Condition="!Exists('$(RimWorldManagedDir)\UnityEngine.AssetBundleModule.dll')"
            Text="UnityEngine.AssetBundleModule.dll is missing. Set RimWorldRoot in mod/FixWorld/Local.Build.props or RIMWORLD_ROOT." />
        <Error Condition="!Exists('$(RimWorldManagedDir)\UnityEngine.ImageConversionModule.dll')"
            Text="UnityEngine.ImageConversionModule.dll is missing. Set RimWorldRoot in mod/FixWorld/Local.Build.props or RIMWORLD_ROOT." />
        <Error Condition="!Exists('$(RimWorldManagedDir)\UnityEngine.IMGUIModule.dll')"
            Text="UnityEngine.IMGUIModule.dll is missing. Set RimWorldRoot in mod/FixWorld/Local.Build.props or RIMWORLD_ROOT." />
        <Error Condition="!Exists('$(RimWorldManagedDir)\UnityEngine.TextRenderingModule.dll')"
            Text="UnityEngine.TextRenderingModule.dll is missing. Set RimWorldRoot in mod/FixWorld/Local.Build.props or RIMWORLD_ROOT." />
    </Target>

    <Target Name="ValidateLocalHarmonyReference"
        BeforeTargets="ResolveReferences"
        Condition="'$(FixWorldUseLocalHarmonyReference)' == 'true'">
        <Error Condition="!Exists('$(HarmonyAssemblyPath)')"
            Text="0Harmony.dll is missing. Set HarmonyAssemblyPath in mod/FixWorld/Local.Build.props or RIMWORLD_HARMONY_ASSEMBLY." />
    </Target>
</Project>
