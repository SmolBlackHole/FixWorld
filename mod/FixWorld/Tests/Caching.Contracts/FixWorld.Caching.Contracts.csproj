<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="../../Source/Caching/*.cs" Link="Caching/%(Filename)%(Extension)" />
    <Compile Include="../../Source/Profiling/*.cs" Link="Profiling/%(Filename)%(Extension)" />
    <Compile Include="../../Source/Telemetry/*.cs" Link="Telemetry/%(Filename)%(Extension)" />
    <Compile Include="../../Source/Settings/TextMeasurementCache.cs" Link="TextMeasurementCache.cs" />
  </ItemGroup>
</Project>
